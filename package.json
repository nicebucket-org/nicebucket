{
  "name": "nicebucket",
  "private": true,
  "version": "0.4.3",
  "type": "module",
  "packageManager": "bun@1.2.20",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "release": "standard-version && git push --follow-tags origin HEAD",
    "build:prod": "NO_STRIP=1 tauri build",
    "build:e2e": "NO_STRIP=1 tauri build --debug --no-bundle",
    "preview": "vite preview",
    "clean": "rm -rf src-tauri/target",
    "tauri": "tauri",
    "test": "vitest run",
    "test:frontend": "vitest",
    "test:e2e": "./scripts/e2e-test.sh",
    "lint": "tsc && eslint .",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "wdio": "wdio run wdio.conf.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "lucide-react": "^1.17.0",
    "next-themes": "^0.4.6",
    "prettier-plugin-organize-imports": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.78.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.8.17",
    "@tauri-apps/cli": "^2",
    "@testing-library/webdriverio": "^3.2.1",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@wdio/cli": "^9.27.2",
    "@wdio/globals": "^9.27.2",
    "@wdio/local-runner": "^9.27.2",
    "@wdio/mocha-framework": "^9.27.2",
    "@wdio/spec-reporter": "^9.27.2",
    "@wdio/types": "^9.27.2",
    "eslint": "^10.4.1",
    "expect-webdriverio": "^5.6.8",
    "prettier": "3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "standard-version": "^9.5.0",
    "tw-animate-css": "^1.3.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "wdio-wait-for": "^3.1.1",
    "webdriverio": "^9.27.2"
